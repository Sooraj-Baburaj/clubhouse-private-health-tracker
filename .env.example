# ---- Database (Supabase: transaction pooler 6543 for the app, session pooler 5432 for migrations) ----
DATABASE_URL=postgres://clubhouse:clubhouse@localhost:54329/clubhouse
DATABASE_URL_MIGRATE=postgres://clubhouse:clubhouse@localhost:54329/clubhouse

# ---- App ----
# Production: APP_ORIGIN=https://<your-domain>, NODE_ENV=production. Generate secrets with: openssl rand -hex 32
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
SESSION_PEPPER=change-me-32-random-bytes-hex
TOTP_ENC_KEY=change-me-32-random-bytes-hex
CRON_SECRET=change-me-32-random-bytes-hex
SETUP_TOKEN=change-me-once
PASSWORD_HASHER=argon2

# ---- Object storage: STORAGE_DRIVER=s3 in production (Supabase Storage S3 endpoint); local = files under .data/storage ----
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_BUCKET=clubhouse-media
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345

# ---- Supabase Realtime (broadcast signals; leave REALTIME_ENABLED=false locally) ----
# The browser gets the URL, anon key and topic names from GET /api/me, so no VITE_ copies are needed.
REALTIME_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ---- Web Push (npx web-push generate-vapid-keys) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- AI (Claude) ----
ANTHROPIC_API_KEY=
# live | mock | off (mock returns deterministic fake results; production uses live)
AI_MODE=mock
# on | off: server-side refusal fallback on Sonnet calls
AI_FALLBACKS=on

# ---- Email (Resend; admin budget alerts + pinger dead-man's switch only) ----
RESEND_API_KEY=
EMAIL_FROM=Clubhouse <clubhouse@example.com>
ADMIN_ALERT_EMAILS=

# ---- Front-end ----
VITE_API_BASE=/api
