{
  "name": "clubhouse",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "concurrently -k -n api,web,admin -c blue,green,magenta \"pnpm --filter @clubhouse/server dev\" \"pnpm --filter @clubhouse/web dev\" \"pnpm --filter @clubhouse/admin dev\"",
    "build": "pnpm build:vercel",
    "build:apps": "pnpm --filter @clubhouse/web build && pnpm --filter @clubhouse/admin build",
    "build:vercel": "pnpm build:apps && node scripts/build-vercel-output.mjs",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm --filter @clubhouse/e2e test",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "pnpm --filter @clubhouse/db generate",
    "db:migrate": "pnpm --filter @clubhouse/db migrate",
    "db:reset": "pnpm --filter @clubhouse/db reset",
    "seed:static": "pnpm --filter @clubhouse/db seed:static",
    "seed:foods": "pnpm --filter @clubhouse/db seed:foods",
    "seed:triggers": "pnpm --filter @clubhouse/db seed:triggers",
    "seed:demo": "pnpm --filter @clubhouse/server seed:demo",
    "board:backfill": "pnpm --filter @clubhouse/server board:backfill",
    "seed:all": "pnpm seed:static && pnpm seed:foods && pnpm seed:triggers",
    "setup:super-admin": "pnpm --filter @clubhouse/db setup:super-admin",
    "icons": "pnpm --filter @clubhouse/web icons"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@date-fns/tz": "^1.5.0",
    "@node-rs/argon2": "^2.2.1",
    "@vercel/functions": "^3.9.9",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "hono": "^4.13.12",
    "otplib": "^13.5.0",
    "postgres": "^3.4.9",
    "resend": "^6.31.0",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vercel/nft": "^1.11.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "@node-rs/argon2"]
  }
}
